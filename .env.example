# Copie para .env.local e preencha com as chaves do projeto Supabase da Vero.
# Nunca commite o .env.local — ele já está no .gitignore.

# Painel Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública (anon/publishable) — usada pro login de profissional e
# cliente (Supabase Auth). Painel Supabase → Project Settings → API Keys.
SUPABASE_ANON_KEY=

# Mesmas duas de cima, só que expostas pro navegador (prefixo
# NEXT_PUBLIC_) — precisa disso pro login com Google, porque o
# redirecionamento pro Google e a volta acontecem no navegador, não numa
# rota de servidor. Sem isso, o botão "Continuar com Google" mostra
# "ainda não configurado" em vez de quebrar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Acesso ao /admin (HTTP Basic Auth) — troque por login de verdade antes de
# dar acesso a mais gente além de vocês dois.
ADMIN_USER=
ADMIN_PASSWORD=

# Envio de email transacional via Resend (resend.com — tem camada gratuita,
# 100 emails/dia). Sem isso, o app funciona igual, só não manda email.
# Painel Resend → API Keys. RESEND_FROM precisa ser um remetente
# verificado no Resend (domínio próprio, ou o domínio de teste deles).
RESEND_API_KEY=
RESEND_FROM="Vero <contato@vero.app>"

# Cobrança via Stripe Checkout (stripe.com). Sem isso, o agendamento
# continua funcionando de graça — a cobrança só liga quando as duas
# variáveis abaixo estiverem preenchidas.
# STRIPE_SECRET_KEY: painel Stripe → Developers → API keys (comece com a
#   chave de teste, sk_test_...).
# STRIPE_WEBHOOK_SECRET: crie um endpoint em Developers → Webhooks
#   apontando para <seu-domínio>/api/stripe/webhook, evento
#   "checkout.session.completed" (e "checkout.session.expired", opcional).
#   O painel mostra o "Signing secret" (whsec_...) desse endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Login com Google pro cliente (Supabase Auth, provedor OAuth). Sem
# configurar, o botão "Continuar com Google" mostra "ainda não
# configurado" e o login por email/senha continua funcionando normal.
# 1. Google Cloud Console (console.cloud.google.com) → crie um projeto
#    (ou use um existente) → APIs e serviços → Credenciais → Criar
#    credenciais → ID do cliente OAuth → tipo "Aplicativo da Web".
#    Em "URIs de redirecionamento autorizados", adicione:
#      https://<seu-projeto>.supabase.co/auth/v1/callback
#    (o painel Supabase → Authentication → Providers → Google mostra
#    esse link pronto pra copiar).
# 2. Copie o Client ID e o Client Secret gerados.
# 3. No painel Supabase → Authentication → Providers → Google: ative,
#    cole o Client ID e o Client Secret, salve.
# 4. Não precisa de mais nenhuma variável aqui — só as
#    NEXT_PUBLIC_SUPABASE_* já preenchidas acima.

# Confirmação/lembrete de sessão via WhatsApp (Twilio — twilio.com).
# Sem isso, o app funciona igual, só não manda WhatsApp (email continua
# saindo normal). O cliente precisa ter cadastrado o telefone (WhatsApp)
# no próprio perfil (/c/dashboard) — sem telefone, pula direto sem erro.
# 1. Crie uma conta em twilio.com (tem trial grátis com crédito).
# 2. Console Twilio → Messaging → Try it out → Send a WhatsApp message:
#    ative o Sandbox do WhatsApp (funciona sem número/aprovação da Meta,
#    ótimo pra testar; pra produção de verdade, depois dá pra pedir um
#    número de WhatsApp Business real pela própria Twilio).
# 3. TWILIO_ACCOUNT_SID e TWILIO_AUTH_TOKEN: Console Twilio → página
#    inicial ("Account Info").
# 4. TWILIO_WHATSAPP_FROM: o número do Sandbox (ou do seu número
#    aprovado), no formato +14155238886 (sem "whatsapp:").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Segredo do cron de lembretes diários (/api/cron/session-reminders, ver
# vercel.json). Gere uma string aleatória qualquer e cole aqui e nas
# variáveis de ambiente da Vercel — a própria Vercel manda esse valor
# automaticamente no header de autorização quando o cron dispara.
CRON_SECRET=

# Google Calendar do profissional (bloquear horários ocupados + criar
# evento quando agenda pelo Vero). Sem isso, o botão "Conectar Google
# Calendar" no painel do profissional só avisa que ainda não está
# disponível — nada quebra.
# Precisa de um client OAuth SEPARADO do que já existe pro login com
# Google (aquele fica só dentro do Supabase; esse aqui o Vero usa
# direto, porque precisa guardar o token de acesso à agenda).
# 1. Google Cloud Console (console.cloud.google.com), mesmo projeto do
#    login com Google → APIs e serviços → Biblioteca → ative a
#    "Google Calendar API".
# 2. APIs e serviços → Credenciais → Criar credenciais → ID do cliente
#    OAuth → tipo "Aplicativo da Web". Em "URIs de redirecionamento
#    autorizados", adicione:
#      https://<seu-domínio>/api/professional/google-calendar/callback
# 3. Copie o Client ID e o Client Secret gerados.
# 4. Tela de permissão OAuth → Dados de acesso: adicione o escopo
#    "https://www.googleapis.com/auth/calendar.events" — como o app
#    ainda está em modo de teste, só contas de teste cadastradas lá
#    conseguem conectar até o Google aprovar o app pra produção (esse
#    escopo é "sensível" — a aprovação pode levar alguns dias).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
