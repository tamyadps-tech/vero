# Copie para .env.local e preencha com as chaves do projeto Supabase da Vero.
# Nunca commite o .env.local — ele já está no .gitignore.

# Painel Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública (anon/publishable) — usada pro login de profissional e
# cliente (Supabase Auth). Painel Supabase → Project Settings → API Keys.
SUPABASE_ANON_KEY=

# Acesso ao /admin (HTTP Basic Auth) — troque por login de verdade antes de
# dar acesso a mais gente além de vocês dois.
ADMIN_USER=
ADMIN_PASSWORD=

# Envio de email transacional via Resend (resend.com — tem camada gratuita,
# 100 emails/dia). Sem isso, o app funciona igual, só não manda email.
# Painel Resend → API Keys. RESEND_FROM precisa ser um remetente
# verificado no Resend (domínio próprio, ou o domínio de teste deles).
RESEND_API_KEY=
RESEND_FROM="Vero <contato@vero.app>"

# Cobrança via Stripe Checkout (stripe.com). Sem isso, o agendamento
# continua funcionando de graça — a cobrança só liga quando as duas
# variáveis abaixo estiverem preenchidas.
# STRIPE_SECRET_KEY: painel Stripe → Developers → API keys (comece com a
#   chave de teste, sk_test_...).
# STRIPE_WEBHOOK_SECRET: crie um endpoint em Developers → Webhooks
#   apontando para <seu-domínio>/api/stripe/webhook, evento
#   "checkout.session.completed" (e "checkout.session.expired", opcional).
#   O painel mostra o "Signing secret" (whsec_...) desse endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
